# Azure Blob Storage
AZURE_BLOB_CONN_STR=your-azure-storage-connection-string

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your-azure-openai-key
AZURE_OPENAI_API_VER=2024-02-01
AZURE_OPENAI_LLM_API_VER=2025-01-01-preview

# PostgreSQL
PG_HOST=your-postgres-server.postgres.database.azure.com
PG_DB=your-database-name
PG_USER=your-database-user
PG_PASS=your-database-password
PG_PORT=5432

# RBAC / JWT
RBAC_JWT_SECRET=generate-a-random-secret-at-least-32-characters
RBAC_ADMIN_EMAIL=admin@example.com
RBAC_ADMIN_PASSWORD=your-admin-password